# Copy to .env.local for local development. Every variable below is read by the app.

# --- Database (Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Clerk authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: networkless JWT verification for Bearer tokens from the mobile app
CLERK_JWT_KEY=

# Comma-separated emails that are promoted to Admin on sign-in
ADMIN_EMAILS=

# --- Public URLs ---
# Used for Paystack callbacks, emails, sitemap and invite links
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=contact@catchersecurities.com
NEXT_PUBLIC_MOBILE_APP_DOWNLOAD_URL=
NEXT_PUBLIC_MOBILE_REFERRAL_DEEP_LINK_BASE=

# --- Paystack ---
# PAYSTACK_ENV selects the key pair: "test" or "live"
PAYSTACK_ENV=test
PAYSTACK_TEST_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_TEST_PUBLIC_KEY=
PAYSTACK_LIVE_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_LIVE_PUBLIC_KEY=

# --- Cloudinary uploads ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=catcher

# --- Resend email ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="Catcher <no-reply@catchersecurities.com>"

# --- Cron (cron-job.org calls /api/internal/cron/* with this secret) ---
CRON_SECRET=

# --- Database browser (disabled in production unless explicitly enabled) ---
ENABLE_DATABASE_BROWSER=false
DATABASE_BROWSER_ALLOWED_EMAILS=
